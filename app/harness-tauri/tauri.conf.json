{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRAM Harness",
  "identifier": "fr.gram.harness",
  "build": {
    "beforeDevCommand": "npm run start:harness",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build:harness",
    "frontendDist": "../ui/dist/harness/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GRAM Harness",
        "width": 1100,
        "height": 760,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["gram-harness"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwMDU0OEQyRERDMjgxRkQKUldUOWdjTGQwa2dGY0tUVUxVM0NoWWZDSkg3dnZpcDNaRHBORTIycWQxdy8zbFIyWTRJM3hDUmsK",
      "endpoints": [
        "https://github.com/TheProdigy27/GRAM/releases/latest/download/latest-harness.json"
      ],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "publisher": "GRAM",
    "category": "Productivity",
    "shortDescription": "Discuter en local avec les modèles ajoutés depuis GRAM",
    "longDescription": "GRAM Harness est une application de discussion pour les modèles installés dans Ollama, en premier ceux que GRAM y a ajoutés, réglés pour la machine. Les conversations restent sur l'ordinateur.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": { "language": "fr-FR" }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
