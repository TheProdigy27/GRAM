/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    // Code de GRAM partagé avec GRAM Harness (projects/harness), sans rien déplacer.
    "paths": {
      "@gram/ui/*": ["./src/app/shared/ui/*"],
      "@gram/types/*": ["./src/app/core/generated/*"],
      "@gram/format": ["./src/app/shared/format.ts"],
      "@gram/theme": ["./src/app/core/theme.ts"],
      "@gram/shortcuts": ["./src/app/core/shortcuts.service.ts"],
      "@gram/scrollbars": ["./src/app/core/scrollbars.service.ts"],
      "@gram/testing/dom": ["./src/testing/dom.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    },
    {
      "path": "./projects/harness/tsconfig.app.json"
    },
    {
      "path": "./projects/harness/tsconfig.spec.json"
    }
  ]
}
