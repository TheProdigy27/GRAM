{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fenêtre principale (n'ajouter que les plugins réellement utilisés).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "clipboard-manager:allow-write-text",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://huggingface.co/*" },
        { "url": "https://github.com/TheProdigy27/GRAM/releases*" }
      ]
    }
  ]
}
