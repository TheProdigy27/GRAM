{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GRAM",
  "identifier": "fr.gram.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist/ui/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GRAM",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg"],
    "publisher": "GRAM",
    "category": "Utility",
    "shortDescription": "Quels modèles IA tournent en local sur cette machine ?",
    "longDescription": "GRAM (GPU & RAM Aware Matcher) analyse le matériel de la machine et classe les modèles IA exécutables en local, à partir des données Hugging Face, avec la commande prête à copier pour Ollama, LM Studio ou llama.cpp.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French"],
        "displayLanguageSelector": false
      },
      "wix": { "language": "fr-FR" }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwMDU0OEQyRERDMjgxRkQKUldUOWdjTGQwa2dGY0tUVUxVM0NoWWZDSkg3dnZpcDNaRHBORTIycWQxdy8zbFIyWTRJM3hDUmsK",
      "endpoints": ["https://github.com/TheProdigy27/GRAM/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
